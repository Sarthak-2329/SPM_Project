# ─────────────────────────────────────────────────────────────────────────────
# CMMS Server — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/cmms_dev?schema=public"
# Direct connection for schema migrations (Neon / Lakebase unpooled)
DATABASE_URL_UNPOOLED="postgresql://postgres:password@localhost:5432/cmms_dev?schema=public"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# CORS: comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173

# ── JWT Authentication ─────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_STRING_OF_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=24h

# ── Email (Nodemailer) ────────────────────────────────────────────────────────
# In development: use Ethereal (https://ethereal.email — auto-generates on startup)
# Set SMTP_USE_ETHEREAL=true to auto-create an Ethereal account at startup.
SMTP_USE_ETHEREAL=true

# For production, set SMTP_USE_ETHEREAL=false and fill in real values:
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_ethereal_user@ethereal.email
SMTP_PASS=your_ethereal_password
SMTP_FROM="CMMS Campus <no-reply@campus.edu>"

# ── File Uploads ──────────────────────────────────────────────────────────────
# Directory for uploaded files (relative to server root)
UPLOAD_DIR=uploads
# Max file size in bytes (default 5 MB)
MAX_FILE_SIZE=5242880

# ── bcrypt ────────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── QR Code Base URL ──────────────────────────────────────────────────────────
# The public base URL used in QR code content (asset detail page)
APP_BASE_URL=http://localhost:5173
