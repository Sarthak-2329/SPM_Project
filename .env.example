# Root Environment Configuration Template
# Copy this file to .env or see server/.env.example for backend configuration.

DATABASE_URL="postgresql://postgres:password@localhost:5432/cmms_dev?schema=public"
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=your_jwt_secret_min_64_characters_long_for_security_purposes_sample
JWT_EXPIRES_IN=24h
SMTP_USE_ETHEREAL=true
APP_BASE_URL=http://localhost:5173
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
BCRYPT_ROUNDS=12
